# Copiar a .env en el servidor y rellenar (nunca subir .env al repositorio).
APP_ENV=production
SECRET_KEY=cambiar-por-cadena-larga-y-aleatoria

# Primer administrador (solo si la tabla usuarios está vacía al arrancar la app)
# ADMIN_BOOTSTRAP_USERNAME=admin
# ADMIN_BOOTSTRAP_PASSWORD=poner-contraseña-segura-aqui
# ADMIN_BOOTSTRAP_EMAIL=admin@tudominio.edu.pe

# Desarrollo local: APP_ENV=development
# Tras HTTPS (proxy): SESSION_COOKIE_SECURE=true (por defecto ya es true si APP_ENV=production)
# SESSION_COOKIE_SECURE=true

# ---------------------------------------------------------------------------
# Base de datos — PostgreSQL (única opción soportada, driver psycopg v3).
# ---------------------------------------------------------------------------
# Forma recomendada (URI completa; se normaliza automáticamente a psycopg3):
SQLALCHEMY_DATABASE_URI=postgresql+psycopg://intranet:intranet@postgres:5432/intranet
#
# Alternativa: DATABASE_URL (convención Heroku/Render/Railway; acepta postgres:// o postgresql://):
# DATABASE_URL=postgres://intranet:intranet@postgres:5432/intranet
#
# Alternativa por variables separadas (se arma la URI automáticamente si no hay
# SQLALCHEMY_DATABASE_URI ni DATABASE_URL):
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432
# POSTGRES_DB=intranet
# POSTGRES_USER=intranet
# POSTGRES_PASSWORD=intranet
#
# Ajustes opcionales del pool de SQLAlchemy:
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_RECYCLE=1800
# DB_POOL_TIMEOUT=30
#
# Para ejecutar los tests (usa una BD distinta):
# TEST_DATABASE_URL=postgresql+psycopg://intranet:intranet@localhost:5432/intranet_test

# Opcional: Firebase (ruta a JSON de credenciales en el servidor)
# FIREBASE_CREDENTIALS_PATH=config/tu-proyecto-firebase-adminsdk.json

# SMTP
MAIL_SERVER=smtp.ejemplo.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SUPPRESS_SEND=False
MAIL_DEBUG=False
